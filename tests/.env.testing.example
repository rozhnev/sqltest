; Disposable PostgreSQL database for DB-backed unit tests, e.g. TokenQuotaUnitTest.
; Copy to tests/.env.testing. The tests DROP and recreate tables in it, so never point
; it at a real database: the name must contain "test" and the production host is refused.
; INI syntax: comments start with ";", quote values with special characters.
TEST_DB_HOST = localhost
TEST_DB_PORT = 5432
TEST_DB_NAME = sqltest_test
TEST_DB_USER = postgres
TEST_DB_PASS = ""
