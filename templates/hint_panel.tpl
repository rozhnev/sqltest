{* Filled by getHelp() in script.js; the hint gets its own block so it doesn't replace the query result *}
<div class="hint-panel hidden" id="hint-panel" aria-live="polite">
    <div class="hint-panel__header">
        <span class="hint-panel__title">{translate}hint_title{/translate}</span>
        <button type="button" class="hint-panel__close" onClick="closeHint()" aria-label="{translate}close{/translate}" title="{translate}close{/translate}">×</button>
    </div>
    <div class="hint-panel__content" id="hint-panel-content"></div>
</div>
