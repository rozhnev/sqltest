# SMTP Configuration for Email Verification
# Required for sending verification codes to users

# SMTP server hostname (e.g., smtp.gmail.com, smtp.mailgun.org)
SMTP_HOST=smtp.example.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=support@sqltest.online

# SMTP authentication password
SMTP_PASS=your_smtp_password_here

# OAuth Providers Configuration
# Add your OAuth provider credentials here
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_SECRET=
# VK_ACCESS_TOKEN=

# Donation progress widget settings
# Monthly target amount in USD
# DONATION_MONTHLY_GOAL=50
# Current month's received donations in USD
# DONATION_RECEIVED_CURRENT_MONTH=0

# Urgent banner visibility (set to true to show the banner on all pages)
# SHOW_URGENT_BANNER=false

# Job interview simulation — Lava.top checkout link for buying interview access.
# Real-time automatic access grants via the Lava.top API/webhook are not wired up yet
# (see INTERVIEW_SIMULATION_PLAN.md, п. 3.5, Вариант A vs Вариант B) — access is granted
# manually in interview_entitlements after payment is confirmed.
# INTERVIEW_LAVA_PAYMENT_URL=https://app.lava.top/products/your-product-id

# AI token budget (see LESSON_ASSISTANT_PLAN.md). One balance per user (users.llm_tokens),
# shared by the lesson assistant and free-answer checks.
# One-time allowance for new accounts; changing it affects only new registrations
# LLM_FREE_TOKENS=50000
# Balance set on every subscription payment (not added; leftovers don't carry over)
# LLM_SUBSCRIBER_CYCLE_TOKENS=1000000
# Minimum balance required to start an LLM call
# LLM_MIN_TOKENS_PER_REQUEST=3000

# Monthly subscription (no ads + subscriber AI budget) — Lava.top checkout link.
# Granted manually after payment: php scripts/grant_subscription.php --user=<email|uuid> --paid-on=YYYY-MM-DD
# SUBSCRIPTION_LAVA_PAYMENT_URL=https://app.lava.top/products/your-product-id
